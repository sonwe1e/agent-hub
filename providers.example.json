  "modelSync": {
    "overrides": {
      "codex": {
        "provider": "tokenfree",
        "model": "gpt-6-astra",
        "reasoningEffort": "high"
      }
    }
  },
  "sync": {
    "targets": {
      "pi": {
        "enabled": true,
        "files": [
          "~/.pi/agent/models.json",
          "~/.pi/agent/auth.json",
          "~/.pi/agent/settings.json"
        ]
      },
      "mcode": {
        "enabled": false,
        "files": [
          "~/.minimax/config.yaml"
        ]
      },
      "zcode": {
        "enabled": false,
        "files": [
          "~/.zcode/v2/provider_config.json"
        ]
      },
      "dsh": {
        "enabled": true,
        "notes": "含 dsh 桌面版 profile (profiles/desktop)",
        "files": [
          "~/.dsh/settings.yaml",
          "~/.dsh/settings.yaml.imported",
          "~/.dsh/profiles/desktop/cordis.patch.yml",
          "~/.dsh/.credentials.yaml"
        ]
      },
      "dsh-desktop": {
        "enabled": true,
        "aliasOf": "dsh",
        "notes": "dsh 桌面版与 dsh 共用 ~/.dsh；桌面 profile 在 profiles/desktop",
        "files": [
          "~/.dsh/profiles/desktop/cordis.patch.yml",
          "~/.dsh/settings.yaml"
        ]
      },
      "claude": {
        "enabled": true,
        "notes": "Claude Code: ~/.claude/settings.json 的 ANTHROPIC_* + cc-switch claude 条目",
        "activeProvider": "tokenfree",
        "featureEnv": {
          "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
        },
        "files": [
          "~/.claude/settings.json"
        ]
      },
      "cc-switch": {
        "enabled": false,
        "files": [
          "~/.cc-switch/cc-switch.db"
        ]
      },
      "omp": {
        "enabled": false,
        "files": [
          "~/.omp/agent/config.yml"
        ]
      },
      "codex": {
        "enabled": true,
        "notes": "官方 / 第三方显式切换；仅基础 config.toml，不访问 auth.json、系统钥匙串或命名 profiles",
        "files": [
          "~/.codex/config.toml",
          "~/.codex/.agent-hub-state.json"
        ],
        "mode": "official"
      }
    },
    "watchIntervalSeconds": 5
  }
}
